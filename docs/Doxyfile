# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------

PROJECT_NAME           = "Nane"
PROJECT_BRIEF          = "A modern C++23 scientific computing library"

OUTPUT_DIRECTORY       = build/docs

# -----------------------------------------------------------------------------
# Input
# -----------------------------------------------------------------------------

INPUT                  = docs/mainpage.dox \
                         docs/groups.dox \
			 docs/namespaces.dox \
                         include \
                         src

RECURSIVE              = YES

FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.dox

EXCLUDE_PATTERNS       = */vendor/* \
                         */build/*

# -----------------------------------------------------------------------------
# Documentation extraction
# -----------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

MARKDOWN_SUPPORT       = YES

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO

# -----------------------------------------------------------------------------
# Source browser
# -----------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# -----------------------------------------------------------------------------
# Warnings
# -----------------------------------------------------------------------------

QUIET                  = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES

WARN_AS_ERROR          = NO

# -----------------------------------------------------------------------------
# Layout
# -----------------------------------------------------------------------------

LAYOUT_FILE            = docs/DoxygenLayout.xml

# -----------------------------------------------------------------------------
# HTML
# -----------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_LATEX         = NO
GENERATE_XML           = NO

HTML_DYNAMIC_MENUS     = YES

# -----------------------------------------------------------------------------
# Doxygen Awesome
# -----------------------------------------------------------------------------

GENERATE_TREEVIEW      = NO
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

HTML_COLORSTYLE        = LIGHT

HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome-css/doxygen-awesome.css \
                         docs/custom.css

# -----------------------------------------------------------------------------
# Math
# -----------------------------------------------------------------------------

USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = SVG

# -----------------------------------------------------------------------------
# Graphviz
# -----------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

COLLABORATION_GRAPH    = YES

CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------

SHOW_INCLUDE_FILES     = NO
SHOW_USED_FILES        = NO
SHOW_FILES             = NO
SHOW_NAMESPACES        = YES

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

# -----------------------------------------------------------------------------
# Language
# -----------------------------------------------------------------------------

OUTPUT_LANGUAGE        = English

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------

TAB_SIZE               = 4
