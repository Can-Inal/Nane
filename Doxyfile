# =============================================================================
# Heron documentation
# =============================================================================

DOXYFILE_ENCODING       = UTF-8

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------

PROJECT_NAME            = "Nane"
PROJECT_NUMBER          = "0.1.0"
PROJECT_BRIEF           = "A scientific computing library."

OUTPUT_LANGUAGE         = English

# -----------------------------------------------------------------------------
# Input
# -----------------------------------------------------------------------------

INPUT                   = lib/include
RECURSIVE               = YES

FILE_PATTERNS           = *.hpp

INPUT_ENCODING          = UTF-8

# Show public include paths as:
#
#   heron/numerics/linspace.hpp
#
# instead of:
#
#   lib/include/heron/numerics/linspace.hpp
#
STRIP_FROM_INC_PATH     = lib/include
STRIP_FROM_PATH         = lib/include

# -----------------------------------------------------------------------------
# Documentation extraction
# -----------------------------------------------------------------------------

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO

HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
HIDE_UNDOC_NAMESPACES   = NO

BUILTIN_STL_SUPPORT     = YES

# -----------------------------------------------------------------------------
# Markdown / comments
# -----------------------------------------------------------------------------

MARKDOWN_SUPPORT        = YES
MARKDOWN_STRICT         = YES
AUTOLINK_SUPPORT        = YES

# -----------------------------------------------------------------------------
# Mathematics
# -----------------------------------------------------------------------------

USE_MATHJAX             = YES
MATHJAX_VERSION         = MathJax_3
MATHJAX_FORMAT          = SVG

# -----------------------------------------------------------------------------
# Warnings
# -----------------------------------------------------------------------------

WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC        = YES

WARN_FORMAT             = "$file:$line: $text"

# -----------------------------------------------------------------------------
# Source browser
# -----------------------------------------------------------------------------

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
STRIP_CODE_COMMENTS     = YES

SHOW_HEADERFILE         = YES
SHOW_INCLUDE_FILES      = YES

# -----------------------------------------------------------------------------
# HTML
# -----------------------------------------------------------------------------

OUTPUT_DIRECTORY        = build/docs

GENERATE_HTML           = YES
HTML_OUTPUT             = html

GENERATE_LATEX          = NO

# -----------------------------------------------------------------------------
# Graphviz
# -----------------------------------------------------------------------------

HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
DOT_NUM_THREADS         = 0

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------

GENERATE_TODOLIST       = YES
GENERATE_TESTLIST       = YES
GENERATE_BUGLIST        = YES
GENERATE_DEPRECATEDLIST = YES

QUIET                   = NO
